# ============================================================
# Mi Segundo Cerebro 4.0 — Variables de Entorno
# ============================================================

# Obligatorio para activar los asistentes de IA (Gemini).
# En Hostinger (Node.js Web App / VPS), configúralo en Environment Variables o en .env.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública de la aplicación
APP_URL="MY_APP_URL"

# ------------------------------------------------------------
# Variables opcionales (solo necesarias si deseas personalizar el despliegue en Hostinger/VPS;
# el servidor ya incluye valores por defecto seguros si se dejan comentadas):
# ------------------------------------------------------------
# GEMINI_MODEL="gemini-3.1-flash-lite"
# GEMINI_FALLBACK_MODELS="gemini-4-hydrogen"
# GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
# GEMINI_TIMEOUT_MS="25000"
# PORT="3000"
# ENABLE_DISK_STORAGE="false"
# DATA_DIR="/home/tu_usuario/domains/tudominio.com/datos"
# APP_LOGIN_USER="admin"
# APP_LOGIN_PASSWORD=""
# SESSION_SECRET=""


